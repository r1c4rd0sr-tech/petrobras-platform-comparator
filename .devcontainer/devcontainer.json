{
  "name": "Petrobras Platform Comparator",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "cd backend && pip install -r requirements.txt && cd ../frontend && npm install",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {"label": "FastAPI", "onAutoForward": "openBrowser"},
    "5173": {"label": "Vite", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}